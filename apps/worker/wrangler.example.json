{
  "compatibility_date": "2024-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hocvnu-db",
      "database_id": "YOUR_D1_DATABASE_ID",
      "migrations_dir": "workers/migrations",
      "remote": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "HOCVNU_R2",
      "bucket_name": "hocvnu-r2",
      "preview_bucket_name": "hocvnu-r2",
      "remote": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOM",
        "class_name": "ChatRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChatRoom"]
    }
  ]
}
