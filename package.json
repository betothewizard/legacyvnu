{
  "name": "legacyvnu",
  "version": "2.0.0",
  "private": true,
  "author": "betothewizard",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "vite preview",
    "scan": "react-scan",
    "deploy:app": "vite build && wrangler pages deploy dist/client --project-name legacyvnu",
    "deploy:worker": "wrangler versions secret bulk .env --name hocvnu-worker && wrangler deploy workers/index.ts --name hocvnu-worker",
    "typecheck": "tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply hocvnu-db --remote",
    "db:migrate-local": "wrangler d1 migrations apply hocvnu-db --local",
    "db:seed": "wrangler d1 execute hocvnu-db --file=./seed.sql",
    "db:studio": "drizzle-kit studio",
    "dev:worker": "wrangler dev workers/index.ts",
    "db:insight": "wrangler d1 insights hocvnu-db --sortBy reads --timePeriod 7d",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@bprogress/core": "^1.3.4",
    "@marsidev/react-turnstile": "^1.5.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@react-pdf-viewer/core": "^3.12.0",
    "@react-pdf-viewer/default-layout": "^3.12.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.11",
    "@tanstack/react-start": "^1.168.20",
    "@tanstack/start-static-server-functions": "^1.167.12",
    "better-auth": "^1.6.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.23",
    "lucide-react": "^0.562.0",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^3.11.174",
    "posthog-js": "^1.381.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-dropzone": "^14.4.1",
    "react-scan": "^0.4.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260605.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "better-sqlite3": "^12.10.0",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.39.0",
    "oxlint": "^1.68.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.5",
    "vite-tsconfig-paths": "^6.1.1",
    "wrangler": "^4.98.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix"
    ]
  },
  "packageManager": "pnpm@10.11.0+sha512.6540583f41cc5f628eb3d9773ecee802f4f9ef9923cc45b69890fb47991d4b092964694ec3a4f738a420c918a333062c8b925d312f42e4f0c263eb603551f977",
  "pnpm": {
    "overrides": {
      "kysely": "0.28.17"
    }
  }
}
