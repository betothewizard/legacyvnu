{
  "name": "legacyvnu",
  "version": "2.0.0",
  "private": true,
  "author": "betothewizard",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @legacyvnu/web dev",
    "dev:web": "pnpm --filter @legacyvnu/web dev",
    "dev:worker": "pnpm --filter @legacyvnu/worker dev",
    "build": "pnpm --filter @legacyvnu/web build",
    "build:web": "pnpm --filter @legacyvnu/web build",
    "start": "pnpm --filter @legacyvnu/web start",
    "scan": "pnpm --filter @legacyvnu/web scan",
    "deploy:app": "pnpm --filter @legacyvnu/web deploy",
    "deploy:worker": "pnpm --filter @legacyvnu/worker deploy",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @legacyvnu/worker db:generate",
    "db:migrate": "pnpm --filter @legacyvnu/worker db:migrate",
    "db:migrate-local": "pnpm --filter @legacyvnu/worker db:migrate-local",
    "db:studio": "pnpm --filter @legacyvnu/worker db:studio",
    "db:insight": "pnpm --filter @legacyvnu/worker db:insight",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r --parallel test:watch",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {},
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260605.1",
    "@types/node": "^25.9.1",
    "better-sqlite3": "^12.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.39.0",
    "oxlint": "^1.68.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix"
    ]
  },
  "packageManager": "pnpm@10.11.0+sha512.6540583f41cc5f628eb3d9773ecee802f4f9ef9923cc45b69890fb47991d4b092964694ec3a4f738a420c918a333062c8b925d312f42e4f0c263eb603551f977"
}
